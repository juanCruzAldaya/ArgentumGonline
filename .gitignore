# Go build output
/server/bin/
*.exe

# Godot
/client/.godot/
/client/android/

# Export output. The web/ directory itself is tracked (empty) so that a fresh
# clone can `docker build` without having exported the client first.
/build/*
!/build/web/
/build/web/*
!/build/web/.gitkeep

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
