; Argentum's arrangement, not a generic game layout. The console runs across the
; top with the minimap beside it, the game viewport sits below, and the
; character panel fills the right edge — inventory and spells as tabs rather
; than stacked, because that is how AO uses that space.
;
;   0                                838      1088        1360
;   +----------------------------------+--------+-----------+  0
;   | consola                          | minimapa | nombre   |
;   +----------------------------------+--------+ nivel/exp |  130
;   |                                           | [inv|hec] |
;   |          viewport 1088x832                |  grilla   |
;   |     17x13 tiles de 32px, escala 2x        |           |
;   |                                           |  barras   |
;   |                                           |  botones  |
;   +-------------------------------------------+-----------+  962
;
; This file holds structure and position only. Everything cosmetic is built in
; hud.gd, so the palette and the slot counts live in one readable place.

[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/net_client.gd" id="2_net"]
[ext_resource type="Script" path="res://scripts/world_view.gd" id="3_view"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/minimap.gd" id="5_minimap"]

