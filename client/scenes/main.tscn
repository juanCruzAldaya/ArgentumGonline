; Layout is the classic Argentum arrangement: game viewport top-left, character
; panel down the right, console along the bottom. The battle royale readouts
; (alive count, zone timer, minimap) sit on top of the viewport rather than
; stealing panel space.
;
; This file holds structure and position only. Everything cosmetic is built in
; hud.gd, so colours and slot counts live in one readable place.

[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/net_client.gd" id="2_net"]
[ext_resource type="Script" path="res://scripts/world_view.gd" id="3_view"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/minimap.gd" id="5_minimap"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="WorldView" type="Node2D" parent="."]
script = ExtResource("3_view")

[node name="Net" type="Node" parent="."]
script = ExtResource("2_net")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Screen" type="Control" parent="UI"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("4_hud")

[node name="TopBar" type="Panel" parent="UI/Screen"]
offset_right = 816.0
offset_bottom = 34.0
mouse_filter = 2

[node name="Alive" type="Label" parent="UI/Screen/TopBar"]
offset_left = 12.0
offset_top = 6.0
offset_right = 400.0
offset_bottom = 28.0
mouse_filter = 2

