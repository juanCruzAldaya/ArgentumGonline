; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Juegito"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; 1088 for the world column (17 tiles x 32px at 2x) plus 525 for the side
; panel, which is the baked panel_bg.png at its native size. Changing either
; number without regenerating the panel image will misalign every control
; sitting on top of it — see the offsets in main.tscn.
window/size/viewport_width=1613
window/size/viewport_height=962
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[autoload]

; Las acciones del InputMap se registran acá en vez de en la sección [input],
; que Godot serializa como Object(InputEventKey, ...) por tecla. El catálogo
; entero vive en un archivo que se lee, con el nombre que cada tecla tiene en
; el Argentum original al lado.
KeyBindings="*res://scripts/key_bindings.gd"

; El sonido, por lo mismo: cualquiera tiene que poder hacer sonar algo sin que
; le pasen una referencia. Se llama GameAudio y no Audio para no pelearse con
; los nombres que Godot ya usa para lo suyo.
GameAudio="*res://scripts/audio.gd"
