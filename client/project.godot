; Godot project file for the juegito client.
;
; The client is a renderer and an input device. All authoritative state lives in
; the Go server, so nothing in here simulates the game.

config_version=5

[application]

config/name="Juegito"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; Argentum's arrangement: a console strip across the top with the minimap beside
; it, the 1088x832 game viewport below (17x13 tiles at the native 32px, drawn at
; 2x so the pixel art stays sharp), and the character panel down the right.
window/size/viewport_width=1360
window/size/viewport_height=962
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
